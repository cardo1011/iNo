<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <script defer type="module">
      import { io } from "https://cdn.socket.io/4.8.3/socket.io.esm.min.js";

      function connectToSocket() {
        return new Promise((resolve, reject) => {
          const socket = io();

          socket.on("connect", () => {
            socket.emit("newConnection");
            resolve(socket);
          });

          socket.on("connect_error", (error) => {
            console.log(error);
            if (!socket.active) {
              reject("Could not connect to socket");
            }
          });
        });
      }

      async function checkSocketConnection() {
        try {
          const socket = await connectToSocket();
          console.log(socket);

          //Create button to invite friend to a room if there is an active socket.
          if (socket.active) {
            console.log("Socket connect: " + socket.id);

            const bdy = document.getElementsByTagName("body")[0];
            const div = document.createElement("div");
            const joinBtn = document.createElement("button");

            joinBtn.append("Invite Friend");
            joinBtn.append;
            div.append(joinBtn);
            bdy.append(div);
          }
        } catch (err) {
          console.error(err);
        }
      }

      // connectToSocket().then(checkSocketConnection);
      checkSocketConnection();
    </script>
  </head>
  <body>
    <h1><%= title %></h1>
    <p>Welcome to <%= title %></p>
  </body>
</html>
